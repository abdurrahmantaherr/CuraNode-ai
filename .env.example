# Copy to .env for local development.
ENVIRONMENT=dev

# Supabase Postgres connection string. Use the session pooler (port 6543) or
# the direct connection (port 5432) from Project Settings → Database.
# NOTE: if you use the transaction-mode pooler, asyncpg needs prepared
# statements disabled — db/session.py already handles this when the host
# matches Supabase's pooler.
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — server-side only, never exposed to templates/JS.
SUPABASE_SERVICE_ROLE_KEY=change-me
# No JWT secret to configure — access tokens are verified against this
# project's public JWKS (Project Settings → API → JWT Settings → asymmetric
# ES256 signing keys), fetched from {SUPABASE_URL}/auth/v1/.well-known/jwks.json.

# Cookies are HttpOnly + SameSite=Strict always. `Secure` may only be relaxed
# for local http development; it is forced true in the pilot environment.
COOKIE_SECURE=false

DEFAULT_LOCALE=en

# ── OAuth (Google sign-in) ───────────────────────────────────────────────
# Supabase dashboard prerequisites:
#   1. Authentication → Providers → enable Google, set its client id/secret.
#   2. Authentication → URL Configuration → add {PUBLIC_BASE_URL}/auth/callback
#      to the redirect allow-list.
#   3. Authentication → Providers → review "allow manual linking" / identity
#      linking behaviour for accounts sharing an email.
#
# Project Settings → API → anon/public key. Safe to expose to a browser, but
# used here only for the server-side PKCE token exchange.
SUPABASE_ANON_KEY=<change.me>
# Absolute base URL this app is served from — builds the OAuth redirect_to.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Master switch. Off by default; requires SUPABASE_ANON_KEY when true.
OAUTH_ENABLED=true
# Comma-separated allow-list of enabled providers.
OAUTH_PROVIDERS=google
# Lifetime (seconds) of a pending OAuth authorization before it expires.
OAUTH_STATE_TTL_S=600

# ── Patient profile (FR2) ────────────────────────────────────────────────
# Write requests (API + web) one patient may make per 60-second window.
# PROFILE_WRITE_RATE_LIMIT_PER_MINUTE=30
# Maximum active allergies / conditions / medications per patient, per list.
# PROFILE_MAX_ENTRIES_PER_LIST=50

# ── Consent / access control (FR4, P9) ───────────────────────────────────
# Grant / change / revoke requests one patient may make per 60-second window.
# CONSENT_WRITE_RATE_LIMIT_PER_MINUTE=10
# Grantee searches one patient may make per 60-second window.
# CONSENT_SEARCH_RATE_LIMIT_PER_MINUTE=30

# ── Doctor schedule (D7) ─────────────────────────────────────────────────
# Schedule write requests one doctor may make per 60-second window.
# SCHEDULE_WRITE_RATE_LIMIT_PER_MINUTE=30

# ── Medical documents (FR10–FR13) ────────────────────────────────────────
# OCR is completely LOCAL and free: no API key, no paid or external service, and
# no document ever leaves the machine. Printed documents only, read by Tesseract
# (install it separately; see the README). Handwriting is not supported.
# Everything below is optional.
#
# Tesseract:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # if not on PATH
# TESSERACT_LANG=eng            # e.g. eng+urd (the language pack must be installed)
# OCR_TIMEOUT_S=60              # per page
# PDFs are rendered to images locally:
# OCR_PDF_DPI=300
# OCR_MAX_PAGES=5               # longer PDFs are refused, not truncated
# OCR_MAX_PIXELS=50000000
# Private Supabase Storage bucket for the originals (already exists in the
# shared project) and the upload limit in bytes (10 MB).
# DATABASE_CONNECT_TIMEOUT_S=25          # give up on one attempt at a NEW database connection after this long (asyncpg's default is 60); retried for blips
# DATABASE_IDLE_PING_S=15                # test a pooled connection that sat idle longer than this before using it (0 = never)
# DOCUMENT_BUCKET=medical-documents
# DOCUMENT_MAX_BYTES=10485760
# DOCUMENT_WRITE_RATE_LIMIT_PER_MINUTE=20
# DOCUMENT_ALLOW_DELETE_FINALIZED=true   # false = a saved record can never be deleted by its patient
# DOCUMENT_PROCESSING_STALE_S=120        # a document stuck in 'processing' this long can be re-processed
#
# AI semantic understanding (Gemini) — OPTIONAL. With no key set, the
# pipeline runs exactly as it did before Gemini existed (deterministic
# extraction/normalization only). Get a free-tier key from Google AI Studio.
# This is the one stage where OCR text leaves the machine — only when you
# opt in here.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_S=20
#
# FALLBACK providers for the same stage — used, in AI_PROVIDER_ORDER, when the
# one before them has no key, hit its rate limit/quota, is down, or returns an
# unusable answer. All opt-in; set any combination. Only OCR TEXT is sent
# (never images). Use synthetic data while on free tiers. If every provider
# fails the pipeline still completes with the deterministic extraction.
# Groq:       https://console.groq.com        (free tier)
# OpenRouter: https://openrouter.ai/keys       (":free" models)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # see console.groq.com/docs/rate-limits for the free-plan models
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free   # free models rotate; see openrouter.ai/models?max_price=0
# AI_PROVIDER_ORDER=gemini,groq,openrouter
# AI_PROVIDER_TIMEOUT_S=20      # per fallback provider call
# AI_PROVIDER_COOLDOWN_S=60     # skip a provider this long after a rate limit
# AI_TOTAL_TIMEOUT_S=45         # ceiling for the whole chain per request
# AI_SECTIONS_ENABLED=true      # false = skip the 2nd AI call (the sections reading) to save free-tier quota
