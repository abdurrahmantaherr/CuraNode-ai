# Copy to .env for local development.
ENVIRONMENT=dev
DATABASE_URL=sqlite+aiosqlite:///./curanode.db

# Must be >= 32 bytes or the application refuses to start (BL-16).
JWT_SECRET=change-me-to-a-real-32-byte-secret-value

# Cookies are HttpOnly + SameSite=Strict always. `Secure` may only be relaxed
# for local http development; it is forced true in the pilot environment.
COOKIE_SECURE=false

DEFAULT_LOCALE=en
