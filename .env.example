# Copy to .env for local development.
ENVIRONMENT=dev

# Supabase Postgres connection string. Use the session pooler (port 6543) or
# the direct connection (port 5432) from Project Settings → Database.
# NOTE: if you use the transaction-mode pooler, asyncpg needs prepared
# statements disabled — db/session.py already handles this when the host
# matches Supabase's pooler.
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — server-side only, never exposed to templates/JS.
SUPABASE_SERVICE_ROLE_KEY=change-me
# No JWT secret to configure — access tokens are verified against this
# project's public JWKS (Project Settings → API → JWT Settings → asymmetric
# ES256 signing keys), fetched from {SUPABASE_URL}/auth/v1/.well-known/jwks.json.

# Cookies are HttpOnly + SameSite=Strict always. `Secure` may only be relaxed
# for local http development; it is forced true in the pilot environment.
COOKIE_SECURE=false

DEFAULT_LOCALE=en
